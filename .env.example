# =============================================================
# CleanLondon — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.
# =============================================================

# --- MySQL Database ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=cleanlondon_db
MYSQL_USER=cleanlondon_user
MYSQL_PASSWORD=change_me_db_password

# --- Database (backend connection) ---
DB_HOST=db
DB_PORT=3306
DB_USER=cleanlondon_user
DB_PASSWORD=change_me_db_password
DB_NAME=cleanlondon_db
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret_min_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- UK GDPR Data Encryption at Rest (Physical Access Codes) ---
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change_me_to_a_fernet_base64_encryption_key

# --- Google APIs ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Environment & Security Controls ---
# Set to "production" on your live server to disable docs, demo endpoints, etc.
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins:
# Development:  http://localhost:8000,http://127.0.0.1:8000
# Production:   https://cleanlondon.co.uk,https://www.cleanlondon.co.uk
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Mock Mode (set to false in production) ---
MOCK_MODE=true

# --- Stripe Payment Gateway ---
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_51YourTestKeyHere
STRIPE_PUBLISHABLE_KEY=pk_test_51YourPublishableKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecretHere
# Used only by the optional local Stripe CLI forwarding service.
STRIPE_CLI_API_KEY=sk_test_YourTestKeyHere
STRIPE_SUCCESS_URL=https://cleanlondon.co.uk/static/success.html?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://cleanlondon.co.uk/static/cancel.html
